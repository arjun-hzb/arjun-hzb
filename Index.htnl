<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Ultimate Creator Portfolio & Game</title>
    <style>
        /* 1. RESET & BASE STYLES */
        body, html {
            margin: 0;
            padding: 0;
            overflow: hidden;
            width: 100%;
            height: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #050505;
            color: #ffffff;
            user-select: none;
        }

        /* 3D Canvas Background */
        #webgl-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        /* 2. UI OVERLAY LAYER */
        .ui-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
            pointer-events: none; /* Allows clicking through to the 3D scene */
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 40px;
            box-sizing: border-box;
        }

        /* Header Style */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo {
            font-size: 1.5rem;
            font-weight: 900;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .current-theme {
            background: rgba(255, 255, 255, 0.1);
            padding: 8px 16px;
            border-radius: 20px;
            backdrop-filter: blur(5px);
            font-size: 0.9rem;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.5s ease;
        }

        /* Main Bio Content */
        .main-content {
            max-width: 600px;
        }
        .tagline {
            font-size: 3.5rem;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 20px;
            text-transform: uppercase;
        }
        .skills-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        .skill-tag {
            background: rgba(255,255,255,0.05);
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 0.85rem;
            border: 1px solid rgba(255,255,255,0.1);
        }

        /* Game UI */
        .game-panel {
            pointer-events: auto; /* Enable clicking here */
            background: rgba(0, 0, 0, 0.6);
            padding: 20px;
            border-radius: 12px;
            max-width: 300px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .game-panel h3 { margin: 0 0 10px 0; font-size: 1.1rem; color: #ff0055; text-transform: uppercase;}
        .score-board { font-size: 1.5rem; font-weight: bold; margin-bottom: 10px; }
        .game-btn {
            background: #ffffff;
            color: #000000;
            border: none;
            padding: 10px 20px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
            text-transform: uppercase;
            transition: transform 0.2s;
        }
        .game-btn:hover { transform: scale(1.05); }

        /* Footer */
        footer {
            text-align: center;
            font-size: 0.8rem;
            color: rgba(255,255,255,0.4);
        }
    </style>

    <!-- Three.js Library hosted via CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <!-- 3D Viewport -->
    <canvas id="webgl-canvas"></canvas>

    <!-- UI Overlay Structure -->
    <div class="ui-container">
        <header>
            <div class="logo">CREATOR.DEV</div>
            <div class="current-theme" id="theme-status">Theme: Loading...</div>
        </header>

        <div style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%;">
            <div class="main-content">
                <div class="tagline" id="dynamic-tagline">I build the future.</div>
                <div class="skills-grid">
                    <span class="skill-tag">3D Developer</span>
                    <span class="skill-tag">Graphic Designer</span>
                    <span class="skill-tag">Video Editor</span>
                    <span class="skill-tag">Digital Marketer</span>
                    <span class="skill-tag">Gamer</span>
                </div>
            </div>

            <!-- Interactive Game Zone -->
            <div class="game-panel">
                <h3>3D Target Game</h3>
                <p style="font-size: 0.85rem; margin: 0 0 10px 0; color: #aaa;">Click the rotating 3D object to score points before the theme shifts!</p>
                <div class="score-board">SCORE: <span id="score-val">0</span></div>
                <button class="game-btn" id="reset-btn">Reset Game</button>
            </div>
        </div>

        <footer>
            &copy; 2026 Full-Stack Portfolio. Powered by Three.js & Creativity.
        </footer>
    </div>

    <!-- 3D ENGINE AND GAME CODE -->
    <script>
        // --- 1. SETUP ENVIRONMENT ---
        const canvas = document.querySelector('#webgl-canvas');
        const scene = new THREE.Scene();
        
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 4.5;

        const renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        // --- 2. LIGHTING ---
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
        scene.add(ambientLight);

        const pointLight = new THREE.PointLight(0xffffff, 2, 50);
        pointLight.position.set(5, 5, 5);
        scene.add(pointLight);

        // --- 3. THE 3D OBJECT (GAME TARGET) ---
        // Exquisite Torus Knot that handles the visual vibe
        const geometry = new THREE.TorusKnotGeometry(1, 0.35, 120, 16);
        const material = new THREE.MeshStandardMaterial({
            roughness: 0.1,
            metalness: 0.8
        });
        const mesh = new THREE.Mesh(geometry, material);
        scene.add(mesh);

        // --- 4. MULTI-THEME DATABASE ---
        // Changes every 10 seconds perfectly
        const themes = [
            {
                name: "Cyberpunk Vibe",
                bg: new THREE.Color('#0b001a'),
                meshColor: new THREE.Color('#ff0055'),
                lightColor: new THREE.Color('#00f0ff'),
                tagline: "Code meets Cyber-Art.",
                wireframe: false
            },
            {
                name: "Vaporwave Retro",
                bg: new THREE.Color('#220033'),
                meshColor: new THREE.Color('#ff00aa'),
                lightColor: new THREE.Color('#ffcc00'),
                tagline: "Synthwave aesthetic lover.",
                wireframe: true
            },
            {
                name: "Matrix Override",
                bg: new THREE.Color('#000802'),
                meshColor: new THREE.Color('#00ff41'),
                lightColor: new THREE.Color('#003300'),
                tagline: "I debug reality.",
                wireframe: false
            },
            {
                name: "Gold Luxury",
                bg: new THREE.Color('#141414'),
                meshColor: new THREE.Color('#d4af37'),
                lightColor: new THREE.Color('#ffffff'),
                tagline: "Premium digital experiences.",
                wireframe: false
            }
        ];

        let currentThemeIndex = 0;
        const clock = new THREE.Clock();

        // --- 5. INTERACTIVE GAME LOGIC ---
        let score = 0;
        const scoreVal = document.getElementById('score-val');
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();

        // Target Clicking Handler
        window.addEventListener('click', (event) => {
            // Screen coordinates ko 3D coordinates me convert karna (Raycasting)
            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObject(mesh);

            // Agar user ne 3D object par click kiya
            if (intersects.length > 0) {
                score++;
                scoreVal.innerText = score;
                
                // Animation Burst reaction
                mesh.scale.set(1.3, 1.3, 1.3);
                setTimeout(() => mesh.scale.set(1, 1, 1), 150);
            }
        });

        // Reset Score Button
        document.getElementById('reset-btn').addEventListener('click', () => {
            score = 0;
            scoreVal.innerText = score;
        });

        // --- 6. CORE ANIMATION & TRANSITION LOOP ---
        const tick = () => {
            const elapsedTime = clock.getElapsedTime();

            // Smooth Continuous Rotation
            mesh.rotation.y = elapsedTime * 0.5;
            mesh.rotation.x = elapsedTime * 0.25;
            
            // Float mesh gently up and down
            mesh.position.y = Math.sin(elapsedTime * 1.5) * 0.15;

            // --- 10 SECONDS ENGINE ---
            const themeDuration = 10;
            const computedIndex = Math.floor(elapsedTime / themeDuration) % themes.length;

            if(computedIndex !== currentThemeIndex) {
                currentThemeIndex = computedIndex;
                
                // Update HTML UI Text dynamically
                document.getElementById('theme-status').innerText = "Theme: " + themes[currentThemeIndex].name;
                document.getElementById('dynamic-tagline').innerText = themes[currentThemeIndex].tagline;
                document.getElementById('theme-status').style.color = '#' + themes[currentThemeIndex].meshColor.getHexString();
            }

            // Lerp Styles (Linear Interpolation for seamless blending transitions)
            const activeTheme = themes[currentThemeIndex];
            scene.background = scene.background ? scene.background.lerp(activeTheme.bg, 0.04) : activeTheme.bg;
            material.color.lerp(activeTheme.meshColor, 0.04);
            pointLight.color.lerp(activeTheme.lightColor, 0.04);
            material.wireframe = activeTheme.wireframe;

            // Render Frame
            renderer.render(scene, camera);
            window.requestAnimationFrame(tick);
        };

        // Initialize First Vibe
        document.getElementById('theme-status').innerText = "Theme: " + themes[0].name;
        document.getElementById('dynamic-tagline').innerText = themes[0].tagline;
        tick();

        // --- 7. RESPONSIVE DESIGN WINDOW HANDLER ---
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

    </script>
</body>
</html>
