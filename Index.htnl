<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For My World, Monika</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Poppins:wght@300;400;600&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #ffe3e3 0%, #ffd1d1 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Floating Hearts Background Animation */
        .hearts-bg {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 1;
            pointer-events: none;
        }

        .heart {
            position: absolute;
            font-size: 20px;
            color: rgba(255, 75, 110, 0.4);
            animation: float Up 6s linear infinite;
            bottom: -50px;
        }

        @keyframes floatUp {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(-105vh) rotate(360deg); opacity: 0; }
        }

        /* Card Container */
        .container {
            width: 90%;
            max-width: 450px;
            height: 550px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(255, 75, 110, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.5);
            z-index: 2;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        /* Page Layout */
        .page {
            position: absolute;
            width: 100%;
            height: 100%;
            padding: 40px 30px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            opacity: 0;
            pointer-events: none;
            transform: translateX(100px);
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .page.active {
            opacity: 1;
            pointer-events: auto;
            transform: translateX(0);
        }

        /* Typography & Elements */
        h1 {
            font-family: 'Dancing Script', cursive;
            font-size: 2.8rem;
            color: #ff4b6e;
            margin-bottom: 15px;
        }

        p {
            font-size: 1rem;
            color: #555;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .btn {
            background: linear-gradient(135deg, #ff4b6e 0%, #ff758c 100%);
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(255, 75, 110, 0.3);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 75, 110, 0.4);
        }

        .btn:active {
            transform: translateY(0);
        }

        .gif-placeholder {
            font-size: 4rem;
            margin-bottom: 20px;
            animation: pulse 1.5s infinite ease-in-out;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        /* Page Specific Styling */
        .btn-group {
            display: flex;
            gap: 15px;
            position: relative;
            width: 100%;
            justify-content: center;
        }

        #no-btn {
            background: #ccc;
            box-shadow: none;
            position: relative;
        }
    </style>
</head>
<body>

    <div class="hearts-bg" id="heartsBg"></div>

    <div class="container">
        <!-- PAGE 1: Entry -->
        <div class="page active" id="page1">
            <div class="gif-placeholder">✨</div>
            <h1>Hello Cutie,</h1>
            <p>Welcome to my world. I built this little space just for you. Ready to step inside?</p>
            <button class="btn" onclick="nextPage(2)">Step Inside</button>
        </div>

        <!-- PAGE 2: The Main Page / Connection -->
        <div class="page" id="page2">
            <div class="gif-placeholder">💖</div>
            <h1>Hey Monika...</h1>
            <p>From the moment you walked into my life, everything changed. You became the center of my universe and the reason behind my biggest smiles.</p>
            <button class="btn" onclick="nextPage(3)">Next ➔</button>
        </div>

        <!-- PAGE 3: The Promise -->
        <div class="page" id="page3">
            <div class="gif-placeholder">🌸</div>
            <h1>My Promise</h1>
            <p>I promise to stand by you through every storm, to celebrate your happiest days, and to hold your hand whenever things get tough.</p>
            <button class="btn" onclick="nextPage(4)">Next ➔</button>
        </div>

        <!-- PAGE 4: The Ultimate Question -->
        <div class="page" id="page4">
            <div class="gif-placeholder">💍</div>
            <h1>The Big Question</h1>
            <p>Monika, you are my today and all of my tomorrows. Will you make me the luckiest person alive?</p>
            <h3 style="color: #ff4b6e; font-family: 'Dancing Script', cursive; font-size: 2.2rem; margin-bottom: 25px;">Will you be mine forever?</h3>
            <div class="btn-group">
                <button class="btn" id="yes-btn" onclick="nextPage(5)">Yes, Always! ➔</button>
                <button class="btn" id="no-btn" onmouseover="moveNoButton()">No</button>
            </div>
        </div>

        <!-- PAGE 5: Celebration -->
        <div class="page" id="page5">
            <div class="gif-placeholder">🎉💝✨</div>
            <h1>Yay! Thank You!</h1>
            <p>You’ve made me the happiest person in the entire world! I love you infinitely, Monika. Forever and always. ❤️</p>
        </div>
    </div>

    <script>
        // Go to next page function
        function nextPage(pageNumber) {
            // Hide all pages
            document.querySelectorAll('.page').forEach(page => {
                page.classList.remove('active');
            });
            // Show requested page
            document.getElementById(`page${pageNumber}`).classList.add('active');

            // Trigger extra explosion on the last page
            if(pageNumber === 5) {
                for(let i=0; i<30; i++) {
                    setTimeout(createHeart, i * 100);
                }
            }
        }

        // Runaway "No" button logic
        function moveNoButton() {
            const noBtn = document.getElementById('no-btn');
            const container = document.querySelector('.container');
            
            // Get boundaries relative to the container
            const containerWidth = container.clientWidth;
            const containerHeight = container.clientHeight;
            
            // Calculate random safe coordinates
            const randomX = Math.floor(Math.random() * (containerWidth - noBtn.clientWidth - 40)) + 20;
            const randomY = Math.floor(Math.random() * (containerHeight - noBtn.clientHeight - 80)) + 40;
            
            noBtn.style.position = 'absolute';
            noBtn.style.left = randomX + 'px';
            noBtn.style.top = randomY + 'px';
        }

        // Continuous Background Hearts
        function createHeart() {
            const heartsBg = document.getElementById('heartsBg');
            const heart = document.createElement('div');
            heart.classList.add('heart');
            heart.innerHTML = ['❤️', '💖', '💝', '🌸', '✨'][Math.floor(Math.random() * 5)];
            
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.animationDuration = (Math.random() * 3 + 3) + 's';
            heart.style.fontSize = (Math.random() * 15 + 15) + 'px';
            
            heartsBg.appendChild(heart);
            
            setTimeout(() => {
                heart.remove();
            }, 6000);
        }

        // Generate background elements
        setInterval(createHeart, 300);
    </script>
</body>
</html>
